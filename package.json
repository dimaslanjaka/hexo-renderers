    "git-command-helper": "^2.0.2",
    "glob": "^11.0.0",
    "globals": "^15.11.0",
    "gulp": "^5.0.0",
    "gulp-cli": "^3.0.0",
    "hexo": "^7.3.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
