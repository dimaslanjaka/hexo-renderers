    "sinon": "^19.0.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "yarn@4.5.1",
  "directories": {
    "test": "test",
    "lib": "dist"
  },
