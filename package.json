{
  "name": "hexo-renderers",
  "version": "3.0.1",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "_config.yml"
  ],
  "keywords": [
    "hexo",
    "hexo-renderer-ejs",
    "hexo-renderer-nunjucks",
    "hexo-renderer-pug",
    "hexo-renderer-stylus",
    "hexo-renderer-sass",
    "hexo-renderer-swig",
    "hexo-renderer-markdown",
    "markdown-it"
  ],
  "author": "dimaslanjaka <dimaslanjaka@gmail.com> (https://www.webmanajemen.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimaslanjaka/hexo-renderers.git"
  },
  "homepage": "https://www.webmanajemen.com/docs/hexo-renderers",
  "scripts": {
    "prepare": "husky",
    "site:clean": "yarn workspace hexo-renderers-site run clean",
    "start": "yarn workspace hexo-renderers-site run start",
    "update": "run-s \"update:**\"",
    "update:ci": "curl -L https://github.com/dimaslanjaka/nodejs-package-types/raw/main/.github/workflows/build-release.yml > .github/workflows/build-release.yml",
    "update:ncu": "npx npm-check-updates -u",
    "update:prettier": "curl -L https://github.com/dimaslanjaka/nodejs-package-types/raw/main/.prettierrc.json > .prettierrc.json",
    "update:packer": "curl -L https://github.com/dimaslanjaka/nodejs-package-types/raw/main/packer.js > packer.cjs",
    "update:resolutions": "npx binary-collections package-resolutions-updater",
    "build:packages": "yarn workspaces foreach --worktree --exclude hexo-renderers run build",
    "build:tsup": "rimraf dist && node build.tsup.js && tsc -b tsconfig.build.json && gulp",
    "build": "tsc -b tsconfig.build.json && rollup -c && gulp",
    "clean": "rimraf dist tmp && npm run build",
    "pretest": "node --no-warnings --experimental-specifier-resolution=node --loader ts-node/esm -r dotenv/config jest.setup.ts",
    "test": "cross-env-shell NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "prepack": "node prepack.cjs --yarn",
    "pack": "node packer.cjs --yarn",
    "prepublish": "node prepack.cjs --yarn",
    "site": "yarn run build && yarn workspace hexo-renderers-test run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "description": "All in one hexo renderers",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
